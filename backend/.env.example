# ── General Server Configuration ─────────────────────────────────
HOST=0.0.0.0
PORT=8001
SECRET_KEY=your-secret-key-change-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Frontend URL (Used for email reset links and push notification click redirects)
FRONTEND_URL=http://localhost:3000

# Allowed CORS Origins (comma-separated list)
# In production, specify your frontend domain. Example: http://localhost:3000,https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=*

# ── Default Admin Credentials ──────────────────────────────────
DEFAULT_SUPERADMIN_EMAIL=superadmin@example.com
DEFAULT_SUPERADMIN_PASSWORD=change-me-superadmin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-admin

# ── Database ───────────────────────────────────────────────────
# Options: "sqlite" | "postgresql"
DB_TYPE=sqlite

# PostgreSQL (only used if DB_TYPE=postgresql)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_db_name

# ── LLM Models ─────────────────────────────────────────────────
OPENAI_API_KEY_PSICOUJA=your_openai_api_key_here
BASE_URL_MODELS_PSICOUJA=http://your-llm-server-domain.com/v1
URL_MODELS_PSICOUJA=/path/to/your/model/directory/
MODEL_PSICOUJA=your-primary-model-name
MODEL_QWEN=your-qwen-model-name
MODEL_GEMMA=your-gemma-model-name

# ── SMTP Email Server ──────────────────────────────────────────
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=465
SMTP_SENDER=no-reply@example.com
# SMTP App Password
PASSWORD=your_smtp_app_password_here

# ── Firebase ───────────────────────────────────────────────────
# Path to service account Firebase credentials JSON.
# If left empty, it will default to the local file 'firebase-adminsdk.json' (or custom configured fallback)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_WEBPUSH_LINK=https://your-frontend-domain.com/
